  m_Name: UiTexts
  m_EditorClassIdentifier: Assembly-CSharp::CardThrow.UiTexts
  tutorialSteps:
  - "\u041D\u0430\u043F\u0430\u0440\u043D\u0438\u043A \u0432 \u0437\u043E\u043B\u043E\u0442\u0435. \u0423 \u043D\u0435\u0433\u043E {score} \u2014 \u0434\u0430\u0439 \u0435\u043C\u0443 21: \u0432\u044B\u0431\u0435\u0440\u0438 \u043A\u0430\u0440\u0442\u0443 \u043A\u043B\u0430\u0432\u0438\u0448\u0430\u043C\u0438 A / D"
  - "\u0421\u0442\u0430\u043A\u0430\u043D \u0437\u0430\u0434\u0435\u0432\u0430\u0442\u044C \u043D\u0435\u043B\u044C\u0437\u044F. \u041F\u0443\u0441\u0442\u0438 \u043A\u0430\u0440\u0442\u0443 \u0434\u0443\u0433\u043E\u0439: \u043A\u043E\u043B\u0435\u0441\u043E \u043C\u044B\u0448\u0438 \u0438\u043B\u0438 Q / E"
  - "\u0417\u0430\u0436\u043C\u0438 \u041B\u041A\u041C \u0438 \u0442\u044F\u043D\u0438 \u043D\u0430\u0437\u0430\u0434, \u043A\u0430\u043A \u0440\u043E\u0433\u0430\u0442\u043A\u0443. \u0422\u043E\u0447\u043A\u0438 \u2014 \u043F\u0443\u0442\u044C \u043A\u0430\u0440\u0442\u044B. \u041E\u0442\u043F\u0443\u0441\u0442\u0438!"
  tutorialSpinNoObstacle: "\u041F\u0443\u0441\u0442\u0438 \u043A\u0430\u0440\u0442\u0443 \u0434\u0443\u0433\u043E\u0439: \u043A\u043E\u043B\u0435\u0441\u043E \u043C\u044B\u0448\u0438 \u0438\u043B\u0438 Q / E"
  tutorialRicochetStep: "\u041F\u0443\u0442\u044C \u0437\u0430\u043A\u0440\u044B\u0442. \u041E\u0442\u0440\u0430\u0437\u0438 \u043A\u0430\u0440\u0442\u0443 \u043E\u0442 \u043F\u0435\u043F\u0435\u043B\u044C\u043D\u0438\u0446\u044B: \u0446\u0435\u043B\u044C\u0441\u044F \u0432 \u0435\u0451 \u0433\u0440\u0430\u043D\u044C, \u0442\u044F\u043D\u0438 \u041B\u041A\u041C \u0438 \u043E\u0442\u043F\u0443\u0441\u0442\u0438"
  tutorialSuccessThrow: "\u0415\u0441\u0442\u044C! \u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0430\u0443\u0447\u0438\u043C\u0441\u044F \u043F\u0443\u0441\u043A\u0430\u0442\u044C \u043A\u0430\u0440\u0442\u0443 \u0434\u0443\u0433\u043E\u0439"
  tutorialSuccessSpin: "\u041A\u0440\u0430\u0441\u0438\u0432\u043E! \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u043F\u0440\u0438\u0451\u043C \u2014 \u0440\u0438\u043A\u043E\u0448\u0435\u0442 \u043E\u0442 \u043F\u0435\u043F\u0435\u043B\u044C\u043D\u0438\u0446\u044B"
  tutorialSuccess: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E! \u0414\u0430\u043B\u044C\u0448\u0435 \u2014 \u043D\u0430 \u0432\u0440\u0435\u043C\u044F, \u043F\u043E\u043A\u0430 \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u0438 \u043E\u0442\u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C"
  tutorialFailUndershoot: "\u041D\u0435\u0434\u043E\u043B\u0451\u0442! \u0422\u044F\u043D\u0438 \u0441\u0438\u043B\u044C\u043D\u0435\u0435"
  tutorialFailOvershoot: "\u041F\u0435\u0440\u0435\u043B\u0451\u0442! \u0422\u044F\u043D\u0438 \u0447\u0443\u0442\u044C \u0441\u043B\u0430\u0431\u0435\u0435"
  tutorialFailSideways: "\u041C\u0438\u043C\u043E! \u041F\u043E\u043F\u0440\u0430\u0432\u044C \u043F\u0440\u0438\u0446\u0435\u043B \u0438\u043B\u0438 \u0434\u0443\u0433\u0443"
  tutorialFailOffTable: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0441\u0438\u043B\u044C\u043D\u043E \u2014 \u043A\u0430\u0440\u0442\u0430 \u0443\u043B\u0435\u0442\u0435\u043B\u0430 \u0441\u043E \u0441\u0442\u043E\u043B\u0430"
  tutorialFailBreakable: "\u0421\u0442\u0430\u043A\u0430\u043D! \u0421\u0434\u0435\u043B\u0430\u0439 \u0434\u0443\u0433\u0443 \u043A\u0440\u0443\u0447\u0435"
  tutorialFailOpponent: "\u0427\u0443\u0436\u0438\u0435 \u043A\u0430\u0440\u0442\u044B \u0442\u0440\u043E\u0433\u0430\u0442\u044C \u043D\u0435\u043B\u044C\u0437\u044F!"
  tutorialFailWrongValue: "\u041D\u0443\u0436\u043D\u0430 \u043A\u0430\u0440\u0442\u0430, \u0434\u0430\u044E\u0449\u0430\u044F \u0440\u043E\u0432\u043D\u043E 21"
  tutorialSkipHint: "Tab \u2014 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C"
  rulesLines:
  - "\u0422\u044B \u2014 \u043A\u0440\u0443\u043F\u044C\u0435-\u0448\u0443\u043B\u0435\u0440. \u041F\u043E\u043A\u0430 \u0438\u0433\u0440\u043E\u043A\u0438 \u043E\u0442\u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C, \u043C\u0435\u0442\u043D\u0438 \u043A\u0430\u0440\u0442\u0443 \u0447\u0435\u0440\u0435\u0437 \u0441\u0442\u043E\u043B \u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A\u0443 \u0432 \u0437\u043E\u043B\u043E\u0442\u0435."
  - "\u0415\u0433\u043E \u043E\u0447\u043A\u0438 + \u0442\u0432\u043E\u044F \u043A\u0430\u0440\u0442\u0430 = <color=#FFD54A>\u0440\u043E\u0432\u043D\u043E 21</color>. \u0421\u0442\u0430\u043A\u0430\u043D\u044B \u043D\u0435 \u0437\u0430\u0434\u0435\u0432\u0430\u0439, \u043A \u0447\u0443\u0436\u0438\u043C \u0438\u0433\u0440\u043E\u043A\u0430\u043C \u043D\u0435 \u043F\u043E\u043F\u0430\u0434\u0430\u0439."
  - "<color=#FF7A66>\u0422\u0440\u0438 \u043F\u0440\u043E\u043C\u0430\u0445\u0430</color> \u2014 \u0438 \u043E\u0445\u0440\u0430\u043D\u0430 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442 \u0442\u0435\u0431\u044F \u043A \u0432\u044B\u0445\u043E\u0434\u0443."
  playButton: "\u0420\u0430\u0437\u0434\u0430\u0432\u0430\u0442\u044C (Space)"
  highScoreFormat: "<voffset=0.14em><size=60%><color=#EADFC4>\u0420\u0415\u041A\u041E\u0420\u0414 \u0417\u0410\u0412\u0415\u0414\u0415\u041D\u0418\u042F</color></size></voffset>   {0}"
  controlsLine: "A / D \u2014 \u043A\u0430\u0440\u0442\u0430   \u2022   \u041B\u041A\u041C: \u0442\u044F\u043D\u0443\u0442\u044C \u043D\u0430\u0437\u0430\u0434 \u0438 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u2014 \u0431\u0440\u043E\u0441\u043E\u043A   \u2022   \u041A\u043E\u043B\u0435\u0441\u043E \u0438\u043B\u0438 Q / E \u2014 \u0434\u0443\u0433\u0430   \u2022   \u041F\u041A\u041C / Esc \u2014 \u043E\u0442\u043C\u0435\u043D\u0430   \u2022   R \u2014 \u0437\u0430\u043D\u043E\u0432\u043E"

  m_Name: UiTexts
  m_EditorClassIdentifier: Assembly-CSharp::CardThrow.UiTexts
  tutorialSteps:
  - "\u041D\u0430\u043F\u0430\u0440\u043D\u0438\u043A \u0432 \u0437\u043E\u043B\u043E\u0442\u0435. \u0423 \u043D\u0435\u0433\u043E {score} \u2014 \u0434\u0430\u0439 \u0435\u043C\u0443 21: \u0432\u044B\u0431\u0435\u0440\u0438 \u043A\u0430\u0440\u0442\u0443 \u043A\u043B\u0430\u0432\u0438\u0448\u0430\u043C\u0438 A / D"
  - "\u0411\u0443\u0442\u044B\u043B\u043A\u0443 \u0437\u0430\u0434\u0435\u0432\u0430\u0442\u044C \u043D\u0435\u043B\u044C\u0437\u044F. \u0417\u0430\u043A\u0440\u0443\u0442\u0438 \u043A\u0430\u0440\u0442\u0443: \u043A\u043E\u043B\u0435\u0441\u043E \u043C\u044B\u0448\u0438 \u0438\u043B\u0438 Q / E"
  - "\u0417\u0430\u0436\u043C\u0438 \u041B\u041A\u041C \u0438 \u0442\u044F\u043D\u0438 \u043D\u0430\u0437\u0430\u0434, \u043A\u0430\u043A \u0440\u043E\u0433\u0430\u0442\u043A\u0443. \u0422\u043E\u0447\u043A\u0438 \u2014 \u043F\u0443\u0442\u044C \u043A\u0430\u0440\u0442\u044B. \u041E\u0442\u043F\u0443\u0441\u0442\u0438!"
  tutorialSuccess: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E! \u0414\u0430\u043B\u044C\u0448\u0435 \u2014 \u043D\u0430 \u0432\u0440\u0435\u043C\u044F, \u043F\u043E\u043A\u0430 \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u0438 \u043E\u0442\u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C"
  tutorialFailUndershoot: "\u041D\u0435\u0434\u043E\u043B\u0451\u0442! \u0422\u044F\u043D\u0438 \u0441\u0438\u043B\u044C\u043D\u0435\u0435"
  tutorialFailOvershoot: "\u041F\u0435\u0440\u0435\u043B\u0451\u0442! \u0422\u044F\u043D\u0438 \u0447\u0443\u0442\u044C \u0441\u043B\u0430\u0431\u0435\u0435"
  tutorialFailSideways: "\u041C\u0438\u043C\u043E! \u041F\u043E\u043F\u0440\u0430\u0432\u044C \u043F\u0440\u0438\u0446\u0435\u043B \u0438\u043B\u0438 \u0437\u0430\u043A\u0440\u0443\u0442"
  tutorialFailOffTable: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0441\u0438\u043B\u044C\u043D\u043E \u2014 \u043A\u0430\u0440\u0442\u0430 \u0443\u043B\u0435\u0442\u0435\u043B\u0430 \u0441\u043E \u0441\u0442\u043E\u043B\u0430"
  tutorialFailBreakable: "\u0411\u0443\u0442\u044B\u043B\u043A\u0430! \u0417\u0430\u043A\u0440\u0443\u0442\u0438 \u0441\u0438\u043B\u044C\u043D\u0435\u0435"
  tutorialFailOpponent: "\u0427\u0443\u0436\u0438\u0435 \u043A\u0430\u0440\u0442\u044B \u0442\u0440\u043E\u0433\u0430\u0442\u044C \u043D\u0435\u043B\u044C\u0437\u044F!"
  tutorialFailWrongValue: "\u041D\u0443\u0436\u043D\u0430 \u043A\u0430\u0440\u0442\u0430, \u0434\u0430\u044E\u0449\u0430\u044F \u0440\u043E\u0432\u043D\u043E 21"
  tutorialSkipHint: "Tab \u2014 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C"
  rulesLines:
  - "\u0422\u044b \u2014 \u043a\u0440\u0443\u043f\u044c\u0435-\u0448\u0443\u043b\u0435\u0440. \u041f\u043e\u043a\u0430 \u0438\u0433\u0440\u043e\u043a\u0438 \u043e\u0442\u0432\u0435\u0440\u043d\u0443\u043b\u0438\u0441\u044c, \u043c\u0435\u0442\u043d\u0438 \u043a\u0430\u0440\u0442\u0443 \u0447\u0435\u0440\u0435\u0437 \u0441\u0442\u043e\u043b \u043d\u0430\u043f\u0430\u0440\u043d\u0438\u043a\u0443 \u0432 \u0437\u043e\u043b\u043e\u0442\u0435."
  - "\u0415\u0433\u043e \u043e\u0447\u043a\u0438 + \u0442\u0432\u043e\u044f \u043a\u0430\u0440\u0442\u0430 = \u0440\u043e\u0432\u043d\u043e 21. \u0411\u0443\u0442\u044b\u043b\u043a\u0438 \u043d\u0435 \u0437\u0430\u0434\u0435\u0432\u0430\u0439, \u043a \u0447\u0443\u0436\u0438\u043c \u0438\u0433\u0440\u043e\u043a\u0430\u043c \u043d\u0435 \u043f\u043e\u043f\u0430\u0434\u0430\u0439."
  - "\u0422\u0440\u0438 \u043f\u0440\u043e\u043c\u0430\u0445\u0430 \u2014 \u0438 \u043e\u0445\u0440\u0430\u043d\u0430 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442 \u0442\u0435\u0431\u044f \u043a \u0432\u044b\u0445\u043e\u0434\u0443."
  playButton: "\u0420\u0430\u0437\u0434\u0430\u0432\u0430\u0442\u044c (Space)"
